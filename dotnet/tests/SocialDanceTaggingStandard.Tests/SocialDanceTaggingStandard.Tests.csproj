<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Plain xUnit Assert — deliberately NOT FluentAssertions: FA v8+ is commercially licensed (Xceed),
         a poor fit for an openly-licensed, dependency-light standard lib. See the ecosystem standards'
         _feedback/exceptions.md ("Sdts — xUnit Assert instead of FluentAssertions"). -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SocialDanceTaggingStandard\SocialDanceTaggingStandard.csproj" />
    <ProjectReference Include="..\SocialDanceTaggingStandard.TestKit\SocialDanceTaggingStandard.TestKit.csproj" />
  </ItemGroup>

</Project>
